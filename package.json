{
  "name": "capitania",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Panel local para encender, apagar y vigilar los puertos de todos los proyectos de la Mac",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danoviel/Capitan-a.git"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run build && npm run start --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "daemon:install": "./scripts/install-daemon.sh",
    "daemon:uninstall": "./scripts/install-daemon.sh --uninstall",
    "daemon:restart": "./scripts/install-daemon.sh --restart",
    "daemon:logs": "./scripts/install-daemon.sh --logs"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
